<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vanderbot Premium</title>
    <style>
        body { background-color: #0d1117; color: white; font-family: sans-serif; text-align: center; padding: 20px; }
        .card { border: 1px solid #30363d; border-radius: 10px; padding: 20px; background: #161b22; }
        button { background-color: #238636; color: white; border: none; padding: 15px 30px; border-radius: 5px; font-weight: bold; width: 100%; cursor: pointer; }
        select { width: 100%; padding: 10px; margin-bottom: 20px; background: #0d1117; color: white; }
        #resultado { margin-top: 20px; font-size: 1.2em; }
        .win { color: #2ea043; font-weight: bold; }
    </style>
</head>
<body>
    <img src="https://i.imgur.com/8a135b.png" width="150" alt="Logo">
    <h2>VANDERBOT PREMIUM</h2>
    <div class="card">
        <label>Selecione a estratégia</label>
        <select id="est">
            <option value="ETARE">ETARE</option>
            <option value="ZEUS">ZEUS OTC</option>
            <option value="WANDER">EXTRA WANDER</option>
        </select>
        <button onclick="analisar()">ANALISAR MERCADO</button>
        <div id="resultado">Clique para analisar...</div>
    </div>

    <script>
        async function analisar() {
            const btn = document.querySelector('button');
            const resDiv = document.getElementById('resultado');
            const est = document.getElementById('est').value;
            
            btn.innerText = "ANALISANDO...";
            resDiv.innerHTML = "Buscando melhor ativo...";

            try {
                const response = await fetch(`https://vanderbot-backend.onrender.com/analizar?estrategia=${est}`);
                const data = await response.json();
                
                resDiv.innerHTML = `
                    <h3>${data.ativo}</h3>
                    <p>Sinal: <strong>${data.sinal}</strong></p>
                    <p>Resultado: <span class="win">${data.resultado}</span></p>
                `;
            } catch (error) {
                resDiv.innerHTML = "Erro ao conectar. Tente novamente.";
            }
            btn.innerText = "ANALISAR MERCADO";
        }
    </script>
</body>
</html>
